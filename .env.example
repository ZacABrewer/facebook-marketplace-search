# Copy to .env (or export in your shell) before `npm start`.

# Listing source: "demo" (synthetic data, works offline) or "facebook" (Playwright scraper).
SOURCE=demo

# Optional: cookies exported from a logged-in Facebook session (JSON array or Netscape cookies.txt).
# Anonymous sessions often get a login wall or a reduced result set.
FB_COOKIES=

# Optional: path to a Chromium/Chrome binary if you don't want Playwright's bundled browser.
CHROMIUM_PATH=
HEADLESS=true

# Photo + description cross-check with Claude. Leave unset to run keyword-only matching.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# ambiguous = only cross-check listings the keyword scorer is unsure about (default)
# all       = cross-check every listing (most accurate, most API spend)
# off       = keyword matching only
VERIFY_MODE=ambiguous
VERIFY_CONCURRENCY=2

PORT=4310
HOST=127.0.0.1
DATA_DIR=./server/data
SCHEDULER_TICK_SECONDS=60
