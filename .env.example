# Copy to .env. docker compose reads this file automatically; for a bare
# `npm start` export these in your shell instead.

# ---- listing source ----
# demo = generated listings that work offline. facebook = real scraping.
SOURCE=demo

# Cookies exported from a browser logged in to Facebook (JSON or Netscape
# cookies.txt). Anonymous scraping usually hits a login wall.
# In Docker this is the path *inside* the container, e.g. /config/cookies.json
FB_COOKIES=

# ---- photo cross-check with Claude ----
# Leave the key unset for keyword-only matching.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# ambiguous = only check listings the keyword scorer is unsure about (default)
# all       = check every listing (most accurate, most API spend)
# off       = keyword matching only
VERIFY_MODE=ambiguous
VERIFY_CONCURRENCY=2

# ---- access control ----
# Set BOTH to require HTTP basic auth. Off when either is empty.
# Strongly recommended if anything but your own machine can reach the port.
AUTH_USER=
AUTH_PASS=

# ---- server ----
# In Docker these are already set correctly by the image; override only if
# running outside a container.
# HOST=127.0.0.1
# PORT=4310
# DATA_DIR=./server/data
TZ=America/New_York
SCHEDULER_TICK_SECONDS=60

# ---- browser (Docker sets these; only needed for bare-metal runs) ----
# CHROMIUM_PATH=
# HEADLESS=true
# CHROMIUM_NO_SANDBOX=false
