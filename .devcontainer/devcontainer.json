{
  "name": "Marketplace Search",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "npm install && npx playwright install --with-deps chromium && npm run build",
  "postAttachCommand": "npm start",
  "forwardPorts": [4310, 5173],
  "portsAttributes": {
    "4310": { "label": "Marketplace Search", "onAutoForward": "openBrowser" },
    "5173": { "label": "Vite dev server", "onAutoForward": "silent" }
  },
  "containerEnv": {
    "HOST": "0.0.0.0",
    "SOURCE": "demo"
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
